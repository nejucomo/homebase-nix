[workspace]
resolver = "3"
members = [
  "HACKNOW{NAME}",
]

[workspace.package]
edition = "2024"
version = "0.1.0"

[workspace.metadata.crane]
name = "HACKNOW{NAME}-workspace"

[workspace.lints.rust]
missing_docs = "deny"
unsafe_code = "deny"

[workspace.dependencies]
yaffa = "0.1.1"
clap = "4.6.7"
