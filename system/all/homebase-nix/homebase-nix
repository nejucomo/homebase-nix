#! /usr/bin/env bash

function main
{
  if [ $# -eq 0 ]
  then
    usage
    exit 0
  fi

  local subcmd="$1"
  shift

  case "$subcmd"
  in
    -h|--help|help)
      usage
      ;;
    develop)
      cmd-develop "$@"
      ;;
    search)
      cmd-search "$@"
      ;;
    *)
      usage >&2
      fail "unknown subcommand: $subcmd"
      ;;
  esac
}

function usage
{
  cat <<__EOF
Usage: ${SCRIPT_NAME} <subcommand> [args...]

Everything for homebase-nix.

Subcommands:

  develop [CMD...]
      Enter a 'nix develop' interactive bash shell for the flake in the
      current directory. If CMD is given, run it in that shell. Renames
      the zellij tab when run inside zellij outside of a nix shell.

  search REGEX
      Search the nixpkgs revision this flake is pinned to for packages
      whose attribute path or package name matches REGEX
      (case-insensitive). The pinned nixpkgs is:
      {{nixpkgs_ref}}

  help, -h, --help
      Show this help.
__EOF
}

function cmd-develop
{
  local title
  local subcmd=()

  if [ $# -eq 0 ]
  then
    title='nixdev'
  else
    title="nixdev: $1"
    subcmd=('-c' "$@")
  fi

  if [ -z "${IN_NIX_SHELL:-}" ] && [ -n "${ZELLIJ:-}" ]
  then
    zellij action rename-tab "$title"
  fi

  set -x
  exec '{{nix}}/bin/nix' develop . \
    --command '{{bashInteractive}}/bin/bash' \
    --rcfile '{{bashrc_dir}}/etc/bashrc-dir/nix-dev-shell-bashrc' \
    -i \
    ${subcmd[@]+"${subcmd[@]}"}
}

function cmd-search
{
  parse-args 'regex' "$@"

  # `nix search` also matches descriptions, so narrow results to
  # attribute path or package name matches:
  '{{nix}}/bin/nix' search --json '{{nixpkgs_ref}}' "$regex" \
    | '{{jq}}/bin/jq' --raw-output --arg re "$regex" '
        to_entries[]
        | (.key | sub("^[^.]+[.][^.]+[.]"; "")) as $attr
        | select(($attr | test($re; "i")) or (.value.pname // "" | test($re; "i")))
        | "* \($attr) (\(.value.version))\n  \(.value.description // "")\n"
      '
}

source '{{bash_postlude}}/lib/postlude.bash'
